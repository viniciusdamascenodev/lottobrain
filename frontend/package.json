{
  "name": "lottobrain-web",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=24.19.0 <25", "npm": ">=12.2.1 <13"},
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "eslint . --max-warnings=0 && next typegen && tsc --noEmit && node --test tests/*.test.mjs && next build"
  },
  "dependencies": {"next": "16.4.3", "react": "19.3.1", "react-dom": "19.3.1"},
  "devDependencies": {
    "@types/node": "24.19.2", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "eslint": "10.13.0", "@eslint/js": "10.0.1", "typescript-eslint": "8.72.1",
    "@next/eslint-plugin-next": "16.4.3", "eslint-plugin-react-hooks": "7.1.1", "typescript": "5.9.3"
  }
}
